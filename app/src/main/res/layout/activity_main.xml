<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UsageStats TV Test"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- 権限状態表示 -->
    <TextView
        android:id="@+id/textPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="権限状態: 確認中..."
        android:textSize="20sp" />

    <!-- エラーメッセージ表示 -->
    <TextView
        android:id="@+id/textErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF5252"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="エラーメッセージ"
        tools:visibility="visible" />

    <!-- ボタンエリア -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:nextFocusRight="@+id/buttonFetchStats"
            android:padding="12dp"
            android:text="Usage Access設定を開く"
            android:textSize="18sp" />

        <Button
            android:id="@+id/buttonFetchStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/buttonOpenSettings"
            android:padding="12dp"
            android:text="利用履歴を取得"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 取得件数表示 -->
    <TextView
        android:id="@+id/textResultCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="取得結果: -"
        android:textSize="20sp" />

    <!-- 利用履歴一覧 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewUsageStats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true" />

</LinearLayout>
